# Production: full API origin, e.g. https://api.YOURDOMAIN.com (admin must be on the same site, e.g. admin.YOURDOMAIN.com,
# so the SameSite=Strict httpOnly cookie is sent). Leave empty in development to use the Vite proxy.
VITE_API_BASE_URL=
# Development proxy target for /api
VITE_DEV_API_PROXY=http://localhost:8000
