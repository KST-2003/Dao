APP_NAME="DAO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dao
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Filesystem: "public" locally; switch to "r2" (S3-compatible) in production.
FILESYSTEM_DISK=public
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Admin dashboard (CORS + httpOnly auth cookie) ---
ADMIN_URL=http://localhost:5173
ADMIN_COOKIE_DOMAIN=
ADMIN_TOKEN_TTL_MINUTES=480

# --- Customer auth ---
CUSTOMER_TOKEN_TTL_DAYS=90
# Comma-separated list of OAuth client IDs whose Google ID tokens we accept (iOS, Android, Web)
GOOGLE_CLIENT_IDS=
# LINE Login channel (secret is server-side only; never ship it in the app)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# --- SMS OTP ---
# SMS_DRIVER=log writes the code to storage/logs (ONLY allowed when APP_ENV=local/testing).
# SMS_DRIVER=thaibulksms sends real SMS. Leave unset in production until a provider is configured:
# the API will answer 503 SMS_NOT_CONFIGURED instead of pretending to send.
SMS_DRIVER=log
THAIBULKSMS_KEY=
THAIBULKSMS_SECRET=
THAIBULKSMS_SENDER=

# --- Payments ---
# Enabled checkout methods (comma list): cod,bank_transfer,stripe
PAYMENT_METHODS=cod,bank_transfer
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=dao://checkout/success
STRIPE_CANCEL_URL=dao://checkout/cancel

# --- Push (Expo) ---
EXPO_PUSH_ACCESS_TOKEN=

# --- Seed admin (used by DatabaseSeeder; change immediately) ---
SEED_ADMIN_EMAIL=admin@dao.local
SEED_ADMIN_PASSWORD=
