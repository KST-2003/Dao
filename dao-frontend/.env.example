# Copy to .env for local development. Never commit .env.
# For EAS builds set these with: npx eas-cli env:create
# A phone can't reach "localhost" — use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google Sign-In OAuth client IDs (public identifiers, not secrets). Leave empty to hide the button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# LINE Login channel ID (public). The channel SECRET lives only on the backend.
EXPO_PUBLIC_LINE_CHANNEL_ID=

# Mapbox (address map picker). The public token (pk.…) is used at runtime for the map + geocoding.
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/streets-v12

# Build-time (app.config.js)
# Secret token (sk.…, DOWNLOADS:READ scope) for downloading the native Mapbox SDK. Never commit; set as an EAS secret.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
EAS_PROJECT_ID=
EAS_OWNER=
APP_BUNDLE_ID=com.daoapp.customer
